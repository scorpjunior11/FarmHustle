{
  "expo": {
    "name": "FarmHustle-frontend",
    "slug": "FarmHustle-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "farmhustlefrontend",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/app_icon.png",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.farmhustle.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#14331F",
        "foregroundImage": "./assets/images/app_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14331F",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/farmhustle_icon_1024.png",
            "imageWidth": 220
          }
        }
      ], [
          "expo-notifications", 
            {
              "icon": "./assets/images/icon.png",
              "color": "#208AEF"
            }]
      
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68ba7577-b477-4aac-b2c7-88cbb7560ac5"
      }
    }
  }
}
